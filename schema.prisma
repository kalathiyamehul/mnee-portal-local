datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  image                 String?
  emailVerified         DateTime? @map("email_verified")
  password              String
  passwordChangedAt     DateTime? @map("password_changed_at")
  lastRoleUpdatedAt     DateTime? @map("last_role_updated_at")
  requiresPasswordReset Boolean   @default(true) @map("requires_password_reset")
  twoFactorSecret       String?   @map("two_factor_secret")
  twoFactorEnabled      Boolean   @default(false) @map("two_factor_enabled")
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  actionRequests    ActionRequest[]    @relation("UserActionRequests")
  actionApprovals   ActionApproval[]   @relation("UserActionApprovals")
  customerRequests   CustomerRequest[]  @relation("UserCustomerRequests")
  customerApprovals  CustomerApproval[] @relation("UserCustomerApprovals")
  freezeRequests    FreezeRequest[]    @relation("UserFreezeRequests")
  freezeApprovals   FreezeApproval[]   @relation("UserFreezeApprovals")
  blacklistRequests BlacklistRequest[] @relation("UserBlacklistRequests")
  mintRequests      MintRequest[]      @relation("UserMintRequests")
  burnRequests      BurnRequest[]      @relation("UserBurnRequests")
  burnApprovals     BurnApproval[]     @relation("UserBurnApprovals")
  customers         Customer[]         @relation("UserCustomers")
  blacklistApprovals BlacklistApproval[] @relation("UserBlacklistApprovals")
  refundRequests    RefundRequest[]    @relation("UserRefundRequests")
  refundApprovals   RefundApproval[]   @relation("UserRefundApprovals")
  roleId            String?
  role              Role?              @relation(fields: [roleId], references: [id])

  @@map("user")
}

model ActionRequest {
  id          String       @id @default(cuid())
  action      String
  status      ActionStatus @default(PENDING)
  requestedBy String       @map("requested_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  requester User             @relation("UserActionRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[]

  @@index([action, status, createdAt])
  @@map("action_request")
}

model FreezeRequest {
  id          String            @id @default(uuid())
  address     String
  status      ActionStatus      @default(PENDING)
  action      FreezeRequestAction
  requestedBy String           @map("requested_by")
  no_of_approvals Int               @default(2) // Add this line
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  requiresApproval Boolean      @default(true) @map("requires_approval")
  reason      String          @default("")

  // Relations
  requester User             @relation("UserFreezeRequests", fields: [requestedBy], references: [id])
  approvals FreezeApproval[]

  @@index([address, status, createdAt])
  @@map("freeze_request")
}

model BlacklistRequest {
  id          String         @id @default(uuid())
  address     String
  status      ActionStatus   @default(PENDING)
  action      BlacklistAction
  no_of_approvals Int               @default(2) // Add this line
  requestedBy String        @map("requested_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  requiresApproval Boolean   @default(true) @map("requires_approval")
  reason      String          @default("")

  // Relations
  requester User               @relation("UserBlacklistRequests", fields: [requestedBy], references: [id])
  approvals BlacklistApproval[]

  @@index([address, status, createdAt])
  @@map("blacklist_request")
}

model BlacklistApproval {
  id                  String    @id @default(uuid())
  blacklistRequestId  String    @map("blacklist_request_id")
  approvedBy          String    @map("approved_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  // Relations
  blacklistRequest    BlacklistRequest @relation(fields: [blacklistRequestId], references: [id])
  approver            User      @relation("UserBlacklistApprovals", fields: [approvedBy], references: [id])

  @@map("blacklist_approval")
}

model CustomerRequest {
  id              String       @id @default(uuid())
  name            String
  email           String
  address         String
  status          ActionStatus @default(PENDING)
  action          CustomerRequestAction
  requestedBy     String       @map("requested_by")
  no_of_approvals Int          @default(2)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  customerId      String?      @map("customer_id")

  // Relations
  requester User               @relation("UserCustomerRequests", fields: [requestedBy], references: [id])
  approvals CustomerApproval[]
  customer  Customer?          @relation(fields: [customerId], references: [id])

  @@map("customer_request")
}

model CustomerApproval {
  id                  String   @id @default(uuid())
  customerRequestId   String   @map("customer_request_id")
  approvedBy          String   @map("approved_by")
  createdAt           DateTime @default(now()) @map("created_at")

  // Relations
  customerRequest CustomerRequest @relation(fields: [customerRequestId], references: [id])
  approver        User           @relation("UserCustomerApprovals", fields: [approvedBy], references: [id])

  @@map("customer_approval")
}

enum CustomerRequestAction {
  CREATE
  UPDATE
}


model MintRequest {
  id              String       @id @default(uuid())
  address         String
  amount          BigInt      @db.BigInt
  no_of_approvals Int         @default(2)
  status          ActionStatus @default(PENDING)
  requestedBy     String      @map("requested_by")
  txid            String      @default("")
  requiresApproval Boolean     @default(true) @map("requires_approval")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  customerId      String?     @map("customer_id")

  // Relations
  requester User             @relation("UserMintRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[] @relation("MintRequestApprovals")
  customer  Customer?        @relation(fields: [customerId], references: [id])

  @@map("mint_request")
}

model ActionApproval {
  id              String   @id @default(uuid())
  actionRequestId String?  @map("action_request_id")
  mintRequestId   String?  @map("mint_request_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  actionRequest ActionRequest? @relation(fields: [actionRequestId], references: [id])
  mintRequest  MintRequest?    @relation("MintRequestApprovals", fields: [mintRequestId], references: [id])
  approver      User           @relation("UserActionApprovals", fields: [approvedBy], references: [id])

  @@map("action_approval")
}

model FreezeApproval {
  id              String   @id @default(uuid())
  freezeRequestId String   @map("freeze_request_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  freezeRequest FreezeRequest @relation(fields: [freezeRequestId], references: [id])
  approver      User         @relation("UserFreezeApprovals", fields: [approvedBy], references: [id])

  @@map("freeze_approval")
}

model BurnRequest {
  id              String       @id @default(uuid())
  amount          BigInt      @db.BigInt
  status          ActionStatus @default(PENDING)
  requestedBy     String       @map("requested_by")
  no_of_approvals Int         @default(2)
  requiresApproval Boolean     @default(true) @map("requires_approval")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  refundAddress   String?      @map("refund_address")
  outpoint        String?
  txid            String      @default("")

  // Relations
  requester User             @relation("UserBurnRequests", fields: [requestedBy], references: [id])
  approvals BurnApproval[]

  @@index([outpoint])
  @@map("burn_request")
}

model BurnApproval {
  id              String   @id @default(uuid())
  burnRequestId   String   @map("burn_request_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  burnRequest BurnRequest @relation(fields: [burnRequestId], references: [id])
  approver    User       @relation("UserBurnApprovals", fields: [approvedBy], references: [id])

  @@map("burn_approval")
}

model RefundRequest {
  id              String       @id @default(uuid())
  outpoint        String      
  refundAddress   String      @map("refund_address")
  amount          BigInt      @db.BigInt
  no_of_approvals Int         @default(2)
  status          ActionStatus @default(PENDING)
  requestedBy     String      @map("requested_by")
  txid            String      @default("")
  requiresApproval Boolean     @default(true) @map("requires_approval")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  requester User             @relation("UserRefundRequests", fields: [requestedBy], references: [id])
  approvals RefundApproval[]

  @@index([outpoint, status, createdAt])
  @@map("refund_request")
}

model RefundApproval {
  id              String   @id @default(uuid())
  refundRequestId String   @map("refund_request_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  refundRequest RefundRequest @relation(fields: [refundRequestId], references: [id])
  approver      User         @relation("UserRefundApprovals", fields: [approvedBy], references: [id])

  @@map("refund_approval")
}

enum BlacklistAction {
  BLACKLIST
  UNBLACKLIST
}

enum FreezeRequestAction {
  FREEZE
  UNFREEZE
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  DONE
  FAILED
  REFUNDED
  SETTLED
}

model Config {
  id            Int    @id @default(1)
  fees          Json
  feeAddress    String @map("fee_address")
  tokenId       String @map("token_id")
  decimals      Int    @default(8)
  latestMinterTx String @map("latest_minter_tx")
  mintAddress   String @map("mint_address")
  burnAddress   String @map("burn_address")
  fundAddress   String @map("fund_address")
  minNoOfApproval  Int    @default(2)
  maxNoOfApproval  Int     @default(50)
  globalJson    Json?

  @@map("config")
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  address     String    @unique
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  no_of_approvals Int   @default(2)
  // Add this relation field
  customerRequests CustomerRequest[]
  
  // Relations
  creator     User      @relation("UserCustomers", fields: [createdBy], references: [id])
  mintRequests MintRequest[]

  @@map("customer")
}

// Role-based Access Control Models
model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  users   User[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permission")
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  role         Role      @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permission")
}


model ActivityLog {
  id          String   @id @default(uuid())
  name        String
  action      String
  description String
  redirectUrl String   @default("")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("activity_log")
}

// Rate limiting and brute force protection models
model RateLimitAttempt {
  id          String   @id @default(uuid())
  identifier  String   // IP address or email
  type        RateLimitType
  attempts    Int      @default(1)
  windowStart DateTime @default(now()) @map("window_start")
  lastAttempt DateTime @default(now()) @map("last_attempt")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([identifier, type])
  @@index([identifier, type, windowStart])
  @@map("rate_limit_attempt")
}

model AccountLockout {
  id            String   @id @default(uuid())
  email         String   @unique
  failedAttempts Int     @default(0) @map("failed_attempts")
  lockedUntil   DateTime? @map("locked_until")
  lastFailedAt  DateTime? @map("last_failed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([email, lockedUntil])
  @@map("account_lockout")
}

enum RateLimitType {
  LOGIN_ATTEMPT
  API_REQUEST
  PASSWORD_RESET
  TWO_FA_ATTEMPT
}
