datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?
  idAddress     String?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  actionRequests    ActionRequest[]    @relation("UserActionRequests")
  actionApprovals   ActionApproval[]   @relation("UserActionApprovals")
  freezeRequests    FreezeRequest[]    @relation("UserFreezeRequests")
  freezeApprovals   FreezeApproval[]   @relation("UserFreezeApprovals")
  blacklistRequests BlacklistRequest[] @relation("UserBlacklistRequests")
  blacklistApprovals BlacklistApproval[] @relation("UserBlacklistApprovals")
  mintRequests      MintRequest[]      @relation("UserMintRequests")
}

model ActionRequest {
  id          String       @id @default(cuid())
  action      String
  status      ActionStatus @default(PENDING)
  requestedBy String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  requester User             @relation("UserActionRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[]
}

model FreezeRequest {
  id          String            @id @default(uuid())
  address     String
  status      ActionStatus      @default(PENDING)
  action      FreezeRequestAction
  requestedBy String
  callbackUrl String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  requiresApproval Boolean      @default(true)

  // Relations
  requester User             @relation("UserFreezeRequests", fields: [requestedBy], references: [id])
  approvals FreezeApproval[]
}

model BlacklistRequest {
  id          String         @id @default(uuid())
  address     String
  status      ActionStatus   @default(PENDING)
  action      BlacklistAction
  requestedBy String
  callbackUrl String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  requiresApproval Boolean   @default(false)

  // Relations
  requester User               @relation("UserBlacklistRequests", fields: [requestedBy], references: [id])
  approvals BlacklistApproval[]
}

model MintRequest {
  id              String       @id @default(uuid())
  address         String
  amount          Int
  status          ActionStatus @default(PENDING)
  requestedBy     String
  latestMinterTx  String?
  requiresApproval Boolean     @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  requester User             @relation("UserMintRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[] @relation("MintRequestApprovals")
}

model ActionApproval {
  id              String   @id @default(uuid())
  actionRequestId String?
  mintRequestId   String?
  approvedBy      String
  createdAt       DateTime @default(now())

  // Relations
  actionRequest ActionRequest? @relation(fields: [actionRequestId], references: [id])
  mintRequest  MintRequest?    @relation("MintRequestApprovals", fields: [mintRequestId], references: [id])
  approver      User           @relation("UserActionApprovals", fields: [approvedBy], references: [id])
}

model FreezeApproval {
  id              String   @id @default(uuid())
  freezeRequestId String
  approvedBy      String
  createdAt       DateTime @default(now())

  // Relations
  freezeRequest FreezeRequest @relation(fields: [freezeRequestId], references: [id])
  approver      User         @relation("UserFreezeApprovals", fields: [approvedBy], references: [id])
}

model BlacklistApproval {
  id                String   @id @default(uuid())
  blacklistRequestId String
  approvedBy        String
  createdAt         DateTime @default(now())

  // Relations
  blacklistRequest BlacklistRequest @relation(fields: [blacklistRequestId], references: [id])
  approver         User            @relation("UserBlacklistApprovals", fields: [approvedBy], references: [id])
}

enum BlacklistAction {
  BLACKLIST
  UNBLACKLIST
}

enum FreezeRequestAction {
  FREEZE
  UNFREEZE
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  DONE
}

model config {
  id          Int    @id @default(1)
  fees        Json
  feeAddress  String @map("fee_address")
  tokenId     String @map("token_id")
  decimals    Int
  latestMinterTx String @map("latest_minter_tx")
}
