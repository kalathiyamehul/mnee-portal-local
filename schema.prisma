datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime? @map("email_verified")
  password      String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  actionRequests    ActionRequest[]    @relation("UserActionRequests")
  actionApprovals   ActionApproval[]   @relation("UserActionApprovals")
  freezeRequests    FreezeRequest[]    @relation("UserFreezeRequests")
  freezeApprovals   FreezeApproval[]   @relation("UserFreezeApprovals")
  blacklists        Blacklist[]        @relation("UserBlacklists")
  mintRequests      MintRequest[]      @relation("UserMintRequests")
  burnRequests      BurnRequest[]      @relation("UserBurnRequests")
  burnApprovals     BurnApproval[]     @relation("UserBurnApprovals")

  @@map("user")
}

model ActionRequest {
  id          String       @id @default(cuid())
  action      String
  status      ActionStatus @default(PENDING)
  requestedBy String       @map("requested_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  requester User             @relation("UserActionRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[]

  @@map("action_request")
}

model FreezeRequest {
  id          String            @id @default(uuid())
  address     String
  status      ActionStatus      @default(PENDING)
  action      FreezeRequestAction
  requestedBy String           @map("requested_by")
  callbackUrl String?          @map("callback_url")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  requiresApproval Boolean      @default(true) @map("requires_approval")

  // Relations
  requester User             @relation("UserFreezeRequests", fields: [requestedBy], references: [id])
  approvals FreezeApproval[]

  @@map("freeze_request")
}

model Blacklist {
  id          String         @id @default(uuid())
  address     String
  status      ActionStatus   @default(APPROVED)
  action      BlacklistAction
  requestedBy String        @map("requested_by")
  callbackUrl String?       @map("callback_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  requester User               @relation("UserBlacklists", fields: [requestedBy], references: [id])

  @@map("blacklist")
}

model MintRequest {
  id              String       @id @default(uuid())
  address         String
  amount          Int
  status          ActionStatus @default(PENDING)
  requestedBy     String      @map("requested_by")
  latestMinterTx  String?     @map("latest_minter_tx")
  requiresApproval Boolean     @default(true) @map("requires_approval")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  requester User             @relation("UserMintRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[] @relation("MintRequestApprovals")

  @@map("mint_request")
}

model ActionApproval {
  id              String   @id @default(uuid())
  actionRequestId String?  @map("action_request_id")
  mintRequestId   String?  @map("mint_request_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  actionRequest ActionRequest? @relation(fields: [actionRequestId], references: [id])
  mintRequest  MintRequest?    @relation("MintRequestApprovals", fields: [mintRequestId], references: [id])
  approver      User           @relation("UserActionApprovals", fields: [approvedBy], references: [id])

  @@map("action_approval")
}

model FreezeApproval {
  id              String   @id @default(uuid())
  freezeRequestId String   @map("freeze_request_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  freezeRequest FreezeRequest @relation(fields: [freezeRequestId], references: [id])
  approver      User         @relation("UserFreezeApprovals", fields: [approvedBy], references: [id])

  @@map("freeze_approval")
}

model BurnRequest {
  id              String       @id @default(uuid())
  amount          Int
  status          ActionStatus @default(PENDING)
  requestedBy     String       @map("requested_by")
  requiresApproval Boolean     @default(true) @map("requires_approval")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  requester User             @relation("UserBurnRequests", fields: [requestedBy], references: [id])
  approvals BurnApproval[]

  @@map("burn_request")
}

model BurnApproval {
  id              String   @id @default(uuid())
  burnRequestId   String   @map("burn_request_id")
  approvedBy      String   @map("approved_by")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  burnRequest BurnRequest @relation(fields: [burnRequestId], references: [id])
  approver    User       @relation("UserBurnApprovals", fields: [approvedBy], references: [id])

  @@map("burn_approval")
}

enum BlacklistAction {
  BLACKLIST
  UNBLACKLIST
}

enum FreezeRequestAction {
  FREEZE
  UNFREEZE
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  DONE
}

model Config {
  id            Int    @id @default(1)
  fees          Json
  feeAddress    String @map("fee_address")
  tokenId       String @map("token_id")
  decimals      Int    @default(8)
  latestMinterTx String @map("latest_minter_tx")
  mintAddress   String @map("mint_address")
  burnAddress   String @map("burn_address")
  fundAddress   String @map("fund_address")

  @@map("config")
}
