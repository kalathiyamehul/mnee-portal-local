datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?
  idAddress     String?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  actionRequests  ActionRequest[]  @relation("UserActionRequests")
  actionApprovals ActionApproval[] @relation("UserActionApprovals")
  freezeRequests  FreezeRequest[]  @relation("UserFreezeRequests")
  mintRequests    MintRequest[]    @relation("UserMintRequests")
}

model ActionRequest {
  id          String       @id @default(cuid())
  action      String
  status      ActionStatus @default(PENDING)
  requestedBy String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  requester User             @relation("UserActionRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[]
}

model FreezeRequest {
  id          String       @id @default(uuid())
  address     String
  status      ActionStatus @default(PENDING)
  action      FreezeAction
  requestedBy String
  callbackUrl String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  requiresApproval Boolean @default(true)

  // Relations
  requester User             @relation("UserFreezeRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[] @relation("FreezeRequestApprovals")
}

model MintRequest {
  id              String       @id @default(uuid())
  address         String
  amount          Int
  status          ActionStatus @default(PENDING)
  requestedBy     String
  latestMinterTx  String?
  requiresApproval Boolean     @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  requester User             @relation("UserMintRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[] @relation("MintRequestApprovals")
}

model ActionApproval {
  id              String   @id @default(uuid())
  actionRequestId String?
  freezeRequestId String?
  mintRequestId   String?
  approvedBy      String
  createdAt       DateTime @default(now())

  // Relations
  actionRequest ActionRequest? @relation(fields: [actionRequestId], references: [id])
  freezeRequest FreezeRequest? @relation("FreezeRequestApprovals", fields: [freezeRequestId], references: [id])
  mintRequest  MintRequest?    @relation("MintRequestApprovals", fields: [mintRequestId], references: [id])
  approver      User           @relation("UserActionApprovals", fields: [approvedBy], references: [id])
}

enum FreezeAction {
  FREEZE
  UNFREEZE
  BLACKLIST
  UNBLACKLIST
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model config {
  id          Int    @id @default(1)
  fees        Json
  feeAddress  String @map("fee_address")
  tokenId     String @map("token_id")
  decimals    Int
}
