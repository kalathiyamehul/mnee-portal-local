datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  emailVerified DateTime?
  idAddress     String?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  actionRequests  ActionRequest[]  @relation("UserActionRequests")
  actionApprovals ActionApproval[] @relation("UserActionApprovals")
  freezeRequests  FreezeRequest[]  @relation("UserFreezeRequests")
}

model ActionRequest {
  id          String       @id @default(cuid())
  action      String
  status      ActionStatus @default(PENDING)
  requestedBy String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  requester User             @relation("UserActionRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[]
}

model FreezeRequest {
  id          String       @id @default(uuid())
  address     String
  status      ActionStatus @default(PENDING)
  action      FreezeAction
  requestedBy String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  requester User             @relation("UserFreezeRequests", fields: [requestedBy], references: [id])
  approvals ActionApproval[] @relation("FreezeRequestApprovals")
}

enum FreezeAction {
  FREEZE
  UNFREEZE
}

model ActionApproval {
  id              String   @id @default(uuid())
  actionRequestId String?
  freezeRequestId String?
  approvedBy      String
  createdAt       DateTime @default(now())

  // Relations
  actionRequest ActionRequest? @relation(fields: [actionRequestId], references: [id])
  freezeRequest FreezeRequest? @relation("FreezeRequestApprovals", fields: [freezeRequestId], references: [id])
  approver      User           @relation("UserActionApprovals", fields: [approvedBy], references: [id])
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model config {
  id          Int    @id @default(1)
  fees        Json
  fee_address String
  token_id    String
  decimals    Int
}
